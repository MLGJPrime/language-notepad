<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/select_all_icon_description"
        android:src="@drawable/ic_unselected"
        tools:ignore="ImageContrastCheck" />

    <TextView
        android:id="@+id/tvAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgSelect"
        android:layout_centerVertical="true"
        android:fontFamily="@font/manrope_regular"
        android:layout_marginStart="8dp"
        android:text="@string/all_text"
        android:textColor="@color/colorSecondaryText"
        android:textSize="12sp"
        tools:ignore="RelativeOverlap" />

    <TextView
        android:id="@+id/tvSelectedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fontFamily="@font/manrope_bold"
        android:text="@string/selected_pairs_text"
        android:textColor="@color/colorText"
        android:textSize="18sp"
        tools:ignore="RelativeOverlap" />

    <ImageView
        android:id="@+id/imgDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_delete"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/delete_icon_description" />
</RelativeLayout>