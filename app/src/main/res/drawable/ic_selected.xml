<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circle background -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="28dp"
                android:height="28dp" />
            <solid android:color="@color/colorButtonIcon" />
        </shape>
    </item>
    <!-- Check mark icon -->
    <item
        android:drawable="@drawable/ic_done_tp"
        android:gravity="center"
        android:width="24dp"
        android:height="24dp" />
</layer-list>
